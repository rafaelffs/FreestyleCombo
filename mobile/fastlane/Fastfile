require "shellwords"

default_platform(:ios)

# CocoaPods (Homebrew) is built against Homebrew's own Ruby
# (/opt/homebrew/opt/ruby/bin/ruby), not the system `ruby` that's normally
# first on PATH. `flutter build ipa` shells out to a Ruby-based CocoaPods
# validity check that uses whatever `ruby` PATH resolves to — with system
# Ruby first, it can't see the cocoapods gem and fails with "CocoaPods not
# installed or not in valid state" even though `pod --version` works fine
# directly. Prepending Homebrew's Ruby here fixes it for every lane in this
# file without requiring a system-wide PATH change.
homebrew_ruby_bin = "/opt/homebrew/opt/ruby/bin"
ENV["PATH"] = "#{homebrew_ruby_bin}:#{ENV.fetch('PATH', '')}" if File.directory?(homebrew_ruby_bin)

platform :ios do
  private_lane :auth do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      duration: 1200,
      in_house: false
    )
  end

  desc "Print current App Store Connect listing metadata for verification"
  lane :check_metadata do
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")

    info = app.fetch_edit_app_info
    if info
      UI.message("AppInfo state=#{info.app_store_state}")
      info.get_app_info_localizations.each do |loc|
        next unless loc.locale == "en-US"
        UI.message("  [#{loc.locale}] name=#{loc.name.inspect} subtitle=#{loc.subtitle.inspect} privacyPolicyUrl=#{loc.privacy_policy_url.inspect}")
      end
    else
      UI.important("No editable app info found")
    end
  end

  desc "List uploaded TestFlight builds and their processing state"
  lane :check_builds do
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate")
    if builds.empty?
      UI.important("No builds found via API at all.")
    else
      builds.each do |b|
        compliance = b.missing_export_compliance? rescue "unknown"
        UI.message("Build #{b.version} (#{b.id}) — processingState=#{b.processing_state} — uploadedDate=#{b.uploaded_date} — expired=#{b.expired} — missingExportCompliance=#{compliance}")
      end
    end

    groups = app.get_beta_groups
    if groups.empty?
      UI.important("No TestFlight groups exist yet — no Internal Testing group has been created.")
    else
      testers = app.get_beta_testers
      groups.each do |g|
        UI.message("Group '#{g.name}' (internal=#{g.is_internal_group})")
      end
      UI.message("All testers on this app: #{testers.map(&:email).join(', ')}")
    end
  end

  desc "Create an Internal Testing group with access to all builds and add yourself as a tester"
  lane :setup_internal_testing do |options|
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")
    email = options[:email] || ENV.fetch("TESTFLIGHT_TESTER_EMAIL")

    groups = app.get_beta_groups
    group = groups.find { |g| g.is_internal_group }
    if group.nil?
      # Not using Spaceship::ConnectAPI.create_beta_group: it unconditionally
      # sends publicLinkLimitEnabled, which the API rejects outright for
      # internal groups ("Public link limit cannot be applied to internal
      # group") — so this posts the same request with that field omitted.
      body = {
        data: {
          attributes: {
            name: "Internal Testers",
            isInternalGroup: true,
            hasAccessToAllBuilds: true
          },
          relationships: { app: { data: { id: app.id, type: "apps" } } },
          type: "betaGroups"
        }
      }
      resp = Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaGroups", body)
      group_id = resp.body["data"]["id"]
      UI.success("Created internal testing group #{group_id}")
    else
      group_id = group.id
      UI.important("Internal testing group already exists (#{group_id}) — reusing")
    end

    existing_tester = app.get_beta_testers(filter: { email: email }).first
    if existing_tester
      UI.important("#{email} is already a beta tester — skipping add")
    else
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [group_id],
        attributes: { email: email }
      )
      UI.success("Added #{email} to Internal Testers")
    end
  end

  desc "Answer 'no non-exempt encryption' for every build missing export compliance"
  lane :clear_export_compliance do
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate")
    builds.each do |b|
      next unless (b.missing_export_compliance? rescue false)
      b.update(attributes: { usesNonExemptEncryption: false })
      UI.success("Cleared export compliance for build #{b.version} (#{b.id})")
    end
  end

  desc "Check whether the Bundle ID / app record already exist"
  lane :check_app do
    auth
    bid = Spaceship::ConnectAPI::BundleId.find("com.rafaelffs.freestyleCombo")
    UI.message(bid ? "BundleId found: id=#{bid.id} name=#{bid.name} platform=#{bid.platform}" : "BundleId NOT found")
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")
    UI.message(app ? "App found: id=#{app.id} name=#{app.name}" : "App NOT found")
  end

  desc "Register the Bundle ID and create the App Store Connect app record"
  lane :create_app do
    auth

    identifier = "com.rafaelffs.freestyleCombo"
    existing = Spaceship::ConnectAPI::BundleId.find(identifier)
    if existing.nil?
      Spaceship::ConnectAPI::BundleId.create(name: "FreestyleCombo", platform: "IOS", identifier: identifier)
      UI.success("Registered Bundle ID #{identifier}")
    else
      UI.important("Bundle ID #{identifier} already registered — skipping")
    end

    existing_app = Spaceship::ConnectAPI::App.find(identifier)
    if existing_app
      UI.important("App record for #{identifier} already exists (#{existing_app.id}) — skipping")
    else
      app = Spaceship::ConnectAPI::App.create(
        name: "FreestyleCombo",
        version_string: "1.0",
        sku: "freestylecombo-ios",
        primary_locale: "en-US",
        bundle_id: identifier,
        platforms: ["IOS"]
      )
      UI.success("Created App Store Connect app record: #{app.id}")
    end
  end

  CI_KEYCHAIN_NAME = "freestylecombo-ci.keychain-db"

  # A dedicated, throwaway signing keychain — not the login keychain — so
  # codesign never needs the Mac's actual login/keychain password (which
  # may be unknown/forgotten). Password is only ever used locally to
  # unlock this one keychain non-interactively.
  private_lane :ensure_ci_keychain do
    password = ENV.fetch("CI_KEYCHAIN_PASSWORD", "freestylecombo-ci-local")
    keychain_path = File.expand_path("~/Library/Keychains/#{CI_KEYCHAIN_NAME}")

    unless File.exist?(keychain_path)
      create_keychain(
        name: CI_KEYCHAIN_NAME,
        password: password,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        add_to_search_list: true
      )
    end
    unlock_keychain(path: keychain_path, password: password, set_default: false, add_to_search_list: true)

    # Without this, codesign fails with the cryptic errSecInternalComponent
    # (or silently prompts for a password that doesn't exist, since it's
    # trying to interactively confirm ACL access) — this grants codesign
    # non-interactive access to every key in this keychain, once.
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{password.shellescape} #{keychain_path.shellescape}")
  end

  desc "Create a distribution certificate + App Store provisioning profile"
  lane :setup_signing do
    auth
    ensure_ci_keychain
    password = ENV.fetch("CI_KEYCHAIN_PASSWORD", "freestylecombo-ci-local")
    keychain_path = File.expand_path("~/Library/Keychains/#{CI_KEYCHAIN_NAME}")

    # Never let cert/sigh drop private keys/profiles inside the repo.
    signing_dir = File.expand_path("~/.appstoreconnect/freestylecombo-signing")
    FileUtils.mkdir_p(signing_dir)
    cert(output_path: signing_dir, keychain_path: keychain_path, keychain_password: password)
    # force: true — otherwise sigh just re-downloads whatever profile
    # already exists by that name, even if the App ID's capabilities
    # (e.g. Sign In with Apple) changed since it was last generated.
    sigh(app_identifier: "com.rafaelffs.freestyleCombo", output_path: signing_dir, force: true)

    # sigh's output_path is NOT the same place xcodebuild reads profiles
    # from — that's ~/Library/MobileDevice/Provisioning Profiles/, keyed
    # by <UUID>.mobileprovision. Without this, `fastlane ios build` keeps
    # using whatever was last manually installed there (discovered the
    # hard way: a regenerated profile with a new entitlement silently had
    # no effect on the next build until this copy happened). Also removes
    # any other locally-installed profile with the same Name, so a stale
    # duplicate can't win a name-based lookup over the fresh one.
    profile_name = "com.rafaelffs.freestyleCombo AppStore"
    profile_path = File.join(signing_dir, "AppStore_com.rafaelffs.freestyleCombo.mobileprovision")
    uuid = sh("security cms -D -i #{profile_path.shellescape} 2>/dev/null | plutil -extract UUID raw -o - -", log: false).strip

    installed_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(installed_dir)
    Dir.glob(File.join(installed_dir, "*.mobileprovision")).each do |existing|
      next if File.basename(existing, ".mobileprovision") == uuid
      existing_name = sh("security cms -D -i #{existing.shellescape} 2>/dev/null | plutil -extract Name raw -o - -", log: false).strip
      next unless existing_name == profile_name
      UI.message("Removing stale local profile #{File.basename(existing)} (same name, older UUID)")
      File.delete(existing)
    end

    installed_path = File.join(installed_dir, "#{uuid}.mobileprovision")
    FileUtils.cp(profile_path, installed_path)
    UI.success("Installed #{profile_name} (#{uuid}) to #{installed_path}")
  end

  # Named after CFBundleDisplayName (FSCombo.ipa), not the pubspec package
  # name — glob instead of hardcoding so a future display-name change
  # doesn't silently break this again.
  def built_ipa_path
    ipa_dir = File.expand_path("../build/ios/ipa", __dir__)
    Dir.glob(File.join(ipa_dir, "*.ipa")).first || UI.user_error!("No .ipa found in #{ipa_dir} — run the build lane first.")
  end

  desc "Build the release IPA"
  lane :build do
    ensure_ci_keychain
    # Scoped to the Runner target only (not Pods/RunnerTests, which don't
    # sign at all) — a blanket xcargs override was forcing the App Store
    # profile onto CocoaPods library targets too, which Xcode rejects.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Runner.xcodeproj",
      code_sign_identity: "Apple Distribution",
      team_id: "6K8AXR83Y3",
      profile_name: "com.rafaelffs.freestyleCombo AppStore",
      targets: ["Runner"]
    )
    # `flutter build ipa` (not gym/build_app) — gym calls xcodebuild archive
    # directly and does NOT regenerate ios/Flutter/Generated.xcconfig, so it
    # silently reuses a stale FLUTTER_BUILD_NUMBER from pubspec.yaml and
    # every upload after the first gets rejected as a duplicate version.
    #
    # --export-options-plist is required: flutter build ipa's own default
    # export step doesn't reliably pick up manual signing/the exact
    # provisioning profile the archive step just used (observed directly:
    # the archive embeds the correct profile, but the export step still
    # rejects it as missing an entitlement the profile actually has) —
    # passing ios/ExportOptions.plist explicitly, with signingStyle manual
    # and the profile named directly, is what actually works.
    export_options_path = File.expand_path("../ios/ExportOptions.plist", __dir__)
    sh("flutter build ipa --release --export-options-plist=#{export_options_path.shellescape}")
  end

  desc "Upload the latest build to TestFlight"
  lane :beta do
    auth
    upload_to_testflight(ipa: built_ipa_path, skip_waiting_for_build_processing: true)
  end

  desc "Push App Store listing metadata + screenshots and attach a build. Does NOT submit for review."
  lane :upload_metadata do |options|
    auth
    deliver(
      app_version: options[:app_version] || "1.0.0",
      build_number: options[:build_number],
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name: "Rafael",
        last_name: "Fashola",
        phone_number: "+34601474653",
        email_address: "ffs.rafael@gmail.com",
        demo_user: "applereview",
        demo_password: "AppReview2026!",
        notes: "Demo account provided for full app testing. No special setup required."
      }
    )
  end

  desc "Set primary/secondary category and content rights declaration"
  lane :set_app_info do
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")

    app.update(attributes: { contentRightsDeclaration: "DOES_NOT_USE_THIRD_PARTY_CONTENT" })
    UI.success("Set content rights declaration: does not use third-party content")

    info = app.fetch_edit_app_info
    info.update_categories(category_id_map: {
      primary_category_id: "SPORTS",
      secondary_category_id: "HEALTH_AND_FITNESS"
    })
    UI.success("Set primary category: Sports, secondary: Health & Fitness")
  end

  desc "Delete all screenshots from the en-US App Store version localization"
  lane :clear_screenshots do
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")
    info = app.fetch_edit_app_info
    version = info.app.fetch_edit_app_store_version rescue nil
    version ||= app.get_app_store_versions(filter: { appStoreState: "PREPARE_FOR_SUBMISSION" }).first
    version.get_app_store_version_localizations.each do |loc|
      next unless loc.locale == "en-US"
      loc.get_app_screenshot_sets.each do |set|
        set.app_screenshots.each do |shot|
          shot.delete!
          UI.message("Deleted #{shot.file_name}")
        end
      end
    end
  end

  desc "Remove duplicate screenshots (deliver's upload retry sometimes double-uploads), keeping one per filename"
  lane :dedupe_screenshots do
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")
    info = app.fetch_edit_app_info
    version = info.app.fetch_edit_app_store_version rescue nil
    version ||= app.get_app_store_versions(filter: { appStoreState: "PREPARE_FOR_SUBMISSION" }).first
    version.get_app_store_version_localizations.each do |loc|
      next unless loc.locale == "en-US"
      loc.get_app_screenshot_sets.each do |set|
        seen = {}
        set.app_screenshots.each do |shot|
          if seen[shot.file_name]
            shot.delete!
            UI.message("Deleted duplicate #{shot.file_name}")
          else
            seen[shot.file_name] = true
          end
        end
      end
    end
  end

  desc "Check whether screenshots are actually attached to the App Store version"
  lane :check_screenshots do
    auth
    app = Spaceship::ConnectAPI::App.find("com.rafaelffs.freestyleCombo")
    info = app.fetch_edit_app_info
    version = info.app.fetch_edit_app_store_version rescue nil
    version ||= app.get_app_store_versions(filter: { appStoreState: "PREPARE_FOR_SUBMISSION" }).first
    if version.nil?
      UI.important("No editable App Store version found")
    else
      UI.message("Version #{version.version_string}")
      version.get_app_store_version_localizations.each do |loc|
        next unless loc.locale == "en-US"
        sets = loc.get_app_screenshot_sets
        sets.each do |set|
          shots = set.app_screenshots
          UI.message("  screenshot set #{set.screenshot_display_type}: #{shots.size} screenshot(s)")
          shots.each { |s| UI.message("    - #{s.file_name} state=#{s.asset_delivery_state}") }
        end
      end
    end
  end
end
